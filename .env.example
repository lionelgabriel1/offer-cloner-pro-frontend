# Configuração pública recomendada para Next.js
NEXT_PUBLIC_SUPABASE_URL=https://projeto-demo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_demo
NEXT_PUBLIC_API_BASE_URL=https://api-demo.exemplo.test

# Compatibilidade legada: VITE_* só é usado quando o nome NEXT_PUBLIC_* correspondente não está definido.
# VITE_SUPABASE_URL=https://projeto-legado-demo.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_legado_demo
# VITE_API_BASE_URL=https://api-legado-demo.exemplo.test
